@@ -0,0 +1,38 @@
+//! Runtime resolution of Windows APIs that predate Windows 8/10 so the image
+//! loads on Windows 7 while callers observe graceful degradation.
+
+use std::ffi::c_void;
+
+use windows_sys::Win32::System::LibraryLoader::GetModuleHandleW;
+use windows_sys::Win32::System::LibraryLoader::GetProcAddress;
+
+/// Resolves a kernel32 entry point by name, returning `None` when the running
+/// Windows release does not export it.
+pub fn kernel32_proc(name: &[u8]) -> Option<*mut c_void> {
+    module_proc("kernel32.dll", name)
+}
+
+fn module_proc(module_name: &str, name: &[u8]) -> Option<*mut c_void> {
+    let mut module_wide: Vec<u16> = module_name.encode_utf16().collect();
+    module_wide.push(0);
+    let mut proc_name = name.to_vec();
+    proc_name.push(0);
+    unsafe {
+        let module = GetModuleHandleW(module_wide.as_ptr());
+        if module == 0 {
+            return None;
+        }
+        let proc = GetProcAddress(module, proc_name.as_ptr())?;
+        Some(proc as *mut c_void)
+    }
+}
+
+/// Resolves a kernel32 entry point into the concrete function pointer type
+/// declared at the call site, or `None` on releases without it.
+#[macro_export]
+macro_rules! win7_proc {
+    ($name:literal as $ty:ty) => {
+        $crate::win7_compat::kernel32_proc($name)
+            .map(|proc| unsafe { std::mem::transmute::<*mut core::ffi::c_void, $ty>(proc) })
+    };
+}
