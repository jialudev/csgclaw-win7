index 0000000000..a879563857
--- /dev/null
+++ b/codex-rs/utils/pty/src/win/winpty.rs
@@ -0,0 +1,369 @@
+// winpty-backed PTY system for Windows releases without ConPTY (pre-1809).
+//
+// winpty ships as winpty.dll plus a winpty-agent.exe helper; both are resolved
+// at runtime so ConPTY-capable systems never require them. The agent hosts a
+// hidden console and bridges it onto named pipes, which this module presents
+// through the same portable_pty::PtySystem contract as ConPtySystem.
+
+use std::fs::File;
+use std::os::windows::io::FromRawHandle;
+use std::sync::Arc;
+use std::sync::Mutex;
+
+use portable_pty::Child;
+use portable_pty::CommandBuilder;
+use portable_pty::MasterPty;
+use portable_pty::PtyPair;
+use portable_pty::PtySize;
+use portable_pty::PtySystem;
+use portable_pty::SlavePty;
+use winapi::shared::minwindef::DWORD;
+use winapi::shared::ntdef::HANDLE;
+use winapi::shared::ntdef::WCHAR;
+use winapi::um::handleapi::CloseHandle;
+use winapi::um::libloaderapi::GetProcAddress;
+use winapi::um::libloaderapi::LoadLibraryW;
+
+use crate::win::job::JobObject;
+use crate::win::psuedocon::build_cmdline;
+use crate::win::psuedocon::build_environment_block;
+use crate::win::psuedocon::resolve_current_directory;
+use crate::win::WinChild;
+
+// https://github.com/rprichard/winpty/blob/master/src/include/winpty_constants.h
+const WINPTY_FLAG_CONCEAL: u64 = 0x0004;
+const WINPTY_SPAWN_FLAG_AUTO_SHUTDOWN: u64 = 0x0001;
+const WINPTY_SPAWN_FLAG_EXIT_SHUTDOWN: u64 = 0x0002;
+
+#[repr(C)]
+struct WinPty {
+    _private: [u8; 0],
+}
+#[repr(C)]
+struct WinPtyCfg {
+    _private: [u8; 0],
+}
+#[repr(C)]
+struct WinPtySpawnCfg {
+    _private: [u8; 0],
+}
+#[repr(C)]
+struct WinPtyError {
+    _private: [u8; 0],
+}
+
+type ConfigNew =
+    unsafe extern "system" fn(agent_flags: u64, err: *mut *mut WinPtyError) -> *mut WinPtyCfg;
+type ConfigSetInitialSize = unsafe extern "system" fn(cfg: *mut WinPtyCfg, cols: i32, rows: i32);
+type SessionOpen = unsafe extern "system" fn(
+    cfg: *const WinPtyCfg,
+    err: *mut *mut WinPtyError,
+) -> *mut WinPty;
+type PipeName = unsafe extern "system" fn(w: *const WinPty) -> *const WCHAR;
+type SetSize = unsafe extern "system" fn(
+    w: *mut WinPty,
+    cols: i32,
+    rows: i32,
+    err: *mut *mut WinPtyError,
+) -> i32;
+type SpawnConfigNew = unsafe extern "system" fn(
+    spawn_flags: u64,
+    appname: *const WCHAR,
+    cmdline: *const WCHAR,
+    cwd: *const WCHAR,
+    env: *const WCHAR,
+    err: *mut *mut WinPtyError,
+) -> *mut WinPtySpawnCfg;
+type Spawn = unsafe extern "system" fn(
+    w: *mut WinPty,
+    cfg: *const WinPtySpawnCfg,
+    out_process: *mut HANDLE,
+    out_thread: *mut HANDLE,
+    out_create_error: *mut DWORD,
+    err: *mut *mut WinPtyError,
+) -> i32;
+type ErrorMessage = unsafe extern "system" fn(err: *mut WinPtyError) -> *const WCHAR;
+type FreeOne = unsafe extern "system" fn(p: *const core::ffi::c_void);
+type ErrorFree = unsafe extern "system" fn(err: *mut WinPtyError);
+
+/// Every entry point codex needs from winpty.dll, resolved once at load time.
+struct WinPtyApi {
+    module: winapi::shared::minwindef::HMODULE,
+    config_new: ConfigNew,
+    config_set_initial_size: ConfigSetInitialSize,
+    open: SessionOpen,
+    conin_name: PipeName,
+    conout_name: PipeName,
+    set_size: SetSize,
+    config_free: FreeOne,
+    spawn_config_new: SpawnConfigNew,
+    spawn_config_free: FreeOne,
+    spawn: Spawn,
+    error_msg: ErrorMessage,
+    error_free: ErrorFree,
+    free: FreeOne,
+}
+
+impl Drop for WinPtyApi {
+    fn drop(&mut self) {
+        unsafe { winapi::um::libloaderapi::FreeLibrary(self.module) };
+    }
+}
+
+impl WinPtyApi {
+    /// Resolve every symbol up front; a missing dll or entry point is a clean
+    /// error, never a load failure of the host process.
+    fn open() -> anyhow::Result<Self> {
+        let name: Vec<u16> = "winpty.dll".encode_utf16().chain([0]).collect();
+        unsafe {
+            let module = LoadLibraryW(name.as_ptr());
+            if module.is_null() {
+                anyhow::bail!("winpty.dll not found; it must sit next to codex.exe");
+            }
+            let resolve = |symbol: &[u8]| -> anyhow::Result<*mut core::ffi::c_void> {
+                let mut symbol = symbol.to_vec();
+                symbol.push(0);
+                let func = GetProcAddress(module, symbol.as_ptr().cast());
+                if func.is_null() {
+                    anyhow::bail!(
+                        "winpty.dll is missing entry point {}",
+                        String::from_utf8_lossy(symbol.strip_suffix(&[0u8]).unwrap_or(&symbol))
+                    );
+                }
+                Ok(func.cast())
+            };
+            let typed = |symbol: &[u8]| -> anyhow::Result<unsafe extern "system" fn()> {
+                let func = resolve(symbol)?;
+                Ok(core::mem::transmute(func))
+            };
+            Ok(Self {
+                module,
+                config_new: core::mem::transmute(typed(b"winpty_config_new")?),
+                config_set_initial_size: core::mem::transmute(typed(
+                    b"winpty_config_set_initial_size",
+                )?),
+                open: core::mem::transmute(typed(b"winpty_open")?),
+                conin_name: core::mem::transmute(typed(b"winpty_conin_name")?),
+                conout_name: core::mem::transmute(typed(b"winpty_conout_name")?),
+                set_size: core::mem::transmute(typed(b"winpty_set_size")?),
+                config_free: core::mem::transmute(typed(b"winpty_config_free")?),
+                spawn_config_new: core::mem::transmute(typed(b"winpty_spawn_config_new")?),
+                spawn_config_free: core::mem::transmute(typed(b"winpty_spawn_config_free")?),
+                spawn: core::mem::transmute(typed(b"winpty_spawn")?),
+                error_msg: core::mem::transmute(typed(b"winpty_error_msg")?),
+                error_free: core::mem::transmute(typed(b"winpty_error_free")?),
+                free: core::mem::transmute(typed(b"winpty_free")?),
+            })
+        }
+    }
+}
+
+fn last_error(api: &WinPtyApi, err: *mut WinPtyError) -> String {
+    unsafe {
+        if err.is_null() {
+            return "unknown winpty error".to_string();
+        }
+        let msg = (api.error_msg)(err);
+        let mut len = 0usize;
+        while *msg.add(len) != 0 {
+            len += 1;
+        }
+        let text = String::from_utf16_lossy(std::slice::from_raw_parts(msg, len));
+        (api.error_free)(err);
+        text
+    }
+}
+
+// winpty pipes are directional: the client writes conin and reads conout;
+// requesting the wrong direction is denied by the pipe's security descriptor.
+fn open_pipe(name_ptr: *const WCHAR, write_end: bool) -> anyhow::Result<File> {
+    let mut len = 0usize;
+    unsafe {
+        while *name_ptr.add(len) != 0 {
+            len += 1;
+        }
+    }
+    let name = unsafe {
+        use std::os::windows::ffi::OsStringExt;
+        std::ffi::OsString::from_wide(std::slice::from_raw_parts(name_ptr, len))
+    };
+    let mut options = File::options();
+    if write_end {
+        options.write(true);
+    } else {
+        options.read(true);
+    }
+    Ok(options.open(&name)?)
+}
+
+#[derive(Default)]
+pub struct WinPtySystem {}
+
+struct Session {
+    api: Arc<WinPtyApi>,
+    wpty: *mut WinPty,
+    readable: File,
+    writable: Option<File>,
+    size: PtySize,
+}
+
+unsafe impl Send for Session {}
+unsafe impl Sync for Session {}
+
+impl Session {
+    fn resize(&mut self, size: PtySize) -> anyhow::Result<()> {
+        let mut err: *mut WinPtyError = std::ptr::null_mut();
+        if unsafe { (self.api.set_size)(self.wpty, size.cols as i32, size.rows as i32, &mut err) }
+            == 0
+        {
+            anyhow::bail!("winpty_set_size failed: {}", last_error(&self.api, err));
+        }
+        self.size = size;
+        Ok(())
+    }
+}
+
+impl PtySystem for WinPtySystem {
+    fn openpty(&self, size: PtySize) -> anyhow::Result<PtyPair> {
+        let api = Arc::new(WinPtyApi::open()?);
+
+        let mut err: *mut WinPtyError = std::ptr::null_mut();
+        unsafe {
+            let cfg = (api.config_new)(WINPTY_FLAG_CONCEAL, &mut err);
+            if cfg.is_null() {
+                anyhow::bail!("winpty_config_new failed: {}", last_error(&api, err));
+            }
+            (api.config_set_initial_size)(cfg, size.cols as i32, size.rows as i32);
+            let wpty = (api.open)(cfg, &mut err);
+            (api.config_free)(cfg.cast());
+            if wpty.is_null() {
+                anyhow::bail!("winpty_open failed: {}", last_error(&api, err));
+            }
+
+            let readable = match open_pipe((api.conout_name)(wpty), /*write_end*/ false) {
+                Ok(file) => file,
+                Err(error) => {
+                    (api.free)(wpty.cast());
+                    return Err(error);
+                }
+            };
+            let writable = match open_pipe((api.conin_name)(wpty), /*write_end*/ true) {
+                Ok(file) => file,
+                Err(error) => {
+                    (api.free)(wpty.cast());
+                    return Err(error);
+                }
+            };
+
+            let master = WinPtyMasterPty {
+                inner: Arc::new(Mutex::new(Session {
+                    api: Arc::clone(&api),
+                    wpty,
+                    readable,
+                    writable: Some(writable),
+                    size,
+                })),
+            };
+            let slave = WinPtySlavePty {
+                inner: master.inner.clone(),
+            };
+            Ok(PtyPair {
+                master: Box::new(master),
+                slave: Box::new(slave),
+            })
+        }
+    }
+}
+
+impl MasterPty for WinPtyMasterPty {
+    fn resize(&self, size: PtySize) -> anyhow::Result<()> {
+        self.inner.lock().unwrap().resize(size)
+    }
+
+    fn get_size(&self) -> anyhow::Result<PtySize> {
+        Ok(self.inner.lock().unwrap().size)
+    }
+
+    fn try_clone_reader(&self) -> anyhow::Result<Box<dyn std::io::Read + Send>> {
+        Ok(Box::new(self.inner.lock().unwrap().readable.try_clone()?))
+    }
+
+    fn take_writer(&self) -> anyhow::Result<Box<dyn std::io::Write + Send>> {
+        Ok(Box::new(
+            self.inner
+                .lock()
+                .unwrap()
+                .writable
+                .take()
+                .ok_or_else(|| anyhow::anyhow!("writer already taken"))?,
+        ))
+    }
+}
+
+struct WinPtyMasterPty {
+    inner: Arc<Mutex<Session>>,
+}
+
+struct WinPtySlavePty {
+    inner: Arc<Mutex<Session>>,
+}
+
+impl SlavePty for WinPtySlavePty {
+    fn spawn_command(&self, cmd: CommandBuilder) -> anyhow::Result<Box<dyn Child + Send + Sync>> {
+        let inner = self.inner.lock().unwrap();
+        let api = Arc::clone(&inner.api);
+
+        let job = Arc::new(JobObject::create()?);
+        let (exe, cmdline) = build_cmdline(&cmd)?;
+        let cwd = resolve_current_directory(&cmd);
+        let env_block = build_environment_block(&cmd);
+
+        let mut err: *mut WinPtyError = std::ptr::null_mut();
+        unsafe {
+            let spawn_cfg = (api.spawn_config_new)(
+                WINPTY_SPAWN_FLAG_AUTO_SHUTDOWN | WINPTY_SPAWN_FLAG_EXIT_SHUTDOWN,
+                exe.as_ptr(),
+                cmdline.as_ptr(),
+                cwd.as_ref().map_or(std::ptr::null(), std::vec::Vec::as_ptr),
+                env_block.as_ptr(),
+                &mut err,
+            );
+            if spawn_cfg.is_null() {
+                anyhow::bail!("winpty_spawn_config_new failed: {}", last_error(&api, err));
+            }
+
+            let mut proc: HANDLE = std::ptr::null_mut();
+            let mut thread: HANDLE = std::ptr::null_mut();
+            let mut create_error: DWORD = 0;
+            let ok = (api.spawn)(
+                inner.wpty,
+                spawn_cfg,
+                &mut proc,
+                &mut thread,
+                &mut create_error,
+                &mut err,
+            );
+            (api.spawn_config_free)(spawn_cfg.cast());
+            if ok == 0 {
+                anyhow::bail!(
+                    "winpty_spawn failed (CreateProcess error {create_error}): {}",
+                    last_error(&api, err)
+                );
+            }
+            let _main_thread = CloseHandle(thread);
+
+            // Attach the job after spawn (winpty offers no spawn-time
+            // attribute); kill operations rely on the job covering the tree.
+            if let Err(error) = job.assign_process(proc.cast()) {
+                winapi::um::processthreadsapi::TerminateProcess(proc, 1);
+                CloseHandle(proc);
+                anyhow::bail!("failed to attach winpty child to job object: {error}");
+            }
+
+            Ok(Box::new(WinChild::new(
+                filedescriptor::OwnedHandle::from_raw_handle(proc.cast()),
+                job,
+            )))
+        }
+    }
+}
